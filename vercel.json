{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/s", "destination": "/api/index" },
    { "source": "/share", "destination": "/api/index" },
    { "source": "/api/:path((?!index$).*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.js": { "includeFiles": "public/**", "maxDuration": 30 }
  },
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/manifest.webmanifest", "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }] }
  ]
}
